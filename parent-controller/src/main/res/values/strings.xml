    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_welcome_title">Welcome to Kid Guard</string>
    <string name="onboarding_welcome_body">Your family\'s calm command center. Keep an eye on screen time, set limits, and protect your kids online — all from one app.</string>
    <string name="onboarding_discover_title">Find their device</string>
    <string name="onboarding_discover_body">Open The Circle and tap Scan network. Any device with Kid Guard on the same Wi-Fi appears automatically. No Wi-Fi? Pair via Bluetooth instead.</string>
    <string name="onboarding_discover_path">The Circle → Scan network</string>
    <string name="onboarding_install_title">Send the child app</string>
    <string name="onboarding_install_body">Your child\'s phone needs its own copy of Kid Guard. Open Control and tap Send child app to share the APK with Quick Share, Bluetooth, or any transfer app.</string>
    <string name="onboarding_install_path">Control → Send child app</string>
    <string name="onboarding_pair_title">Scan to connect</string>
    <string name="onboarding_pair_body">Open Kid Guard on the child\'s phone and keep its QR code on screen. On your phone, tap Pair with QR and scan it — the device joins your circle instantly.</string>
    <string name="onboarding_pair_path">Pair with QR</string>
    <string name="onboarding_control_title">Guard and guide</string>
    <string name="onboarding_control_body">Tap any device to open its console. Lock the screen, block apps, set daily time limits, take breaks, and follow today\'s report.</string>
    <string name="onboarding_control_path">Device console</string>

    <!-- ============ Device Owner guide (full Samsung tutorial) ============ -->
    <string name="device_owner_guide_copy">Copy</string>
    <string name="device_owner_guide_copied">Command copied — paste it in PowerShell / terminal</string>
    <string name="device_owner_guide_phase_1_title">Back up, then factory-reset</string>
    <string name="device_owner_guide_phase_1_body">Device Owner only works on a fresh device. Back up photos and files, then Settings → General management → Reset → Factory data reset.</string>
    <string name="device_owner_guide_phase_2_title">First boot: skip all accounts</string>
    <string name="device_owner_guide_phase_2_body">Connect Wi-Fi, but do NOT add any Google or Samsung account yet. Skip sign-in — accounts block the owner command.</string>
    <string name="device_owner_guide_phase_3_title">Enable USB debugging</string>
    <string name="device_owner_guide_phase_3_body">Settings → About tablet → Software information → tap Build number 7 times. Then Developer options → USB debugging ON. Connect to PC and accept the prompt.</string>
    <string name="device_owner_guide_phase_4_title">Install the child APK</string>
    <string name="device_owner_guide_phase_4_body">From this parent app use “Send child app”, or from PC run: adb install -r kidguard-child.apk. Check with: adb devices.</string>
    <string name="device_owner_guide_phase_5_title">Set Kid Guard as Device Owner</string>
    <string name="device_owner_guide_phase_5_body">On PC, run the ADB command above (copy button). Success says “Device owner set”. Now accounts can be added back.</string>
    <string name="device_owner_guide_phase_6_title">Grant every permission</string>
    <string name="device_owner_guide_phase_6_body">Open the child app: allow Usage Access, Display over other apps, Accessibility (Kid Guard Blocker), and Bluetooth. Keep its QR code on screen.</string>
    <string name="device_owner_guide_phase_7_title">Samsung keep-alive (do not skip)</string>
    <string name="device_owner_guide_phase_7_body">Apps → System Service → Battery → Unrestricted. Battery → Background limits → Never sleeping apps → add it. Device care → Auto optimization OFF.</string>
    <string name="device_owner_guide_phase_8_title">Pair from the parent</string>
    <string name="device_owner_guide_phase_8_body">Parent app → The Circle → Pair with QR → scan the tablet. Same Wi-Fi for first pairing; Bluetooth and cloud relay work after.</string>
    <string name="device_owner_guide_phase_9_title">Verify, then hide the icon</string>
    <string name="device_owner_guide_phase_9_body">Open the child console → Advanced → “privileges confirmed”. Only then use Hide Icon in the child app. Manage it from the parent afterwards.</string>
    <string name="device_owner_guide_trouble_title">If the command fails</string>
    <string name="device_owner_guide_trouble_body">“Accounts added” → remove all Google/Samsung accounts and retry. “Already provisioned” → factory-reset again. “No device” → check cable, adb devices, accept the USB prompt.</string>

