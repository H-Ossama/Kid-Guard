    <string name="device_owner_guide_subtitle">Prepare a child device for advanced controls</string>
    <string name="device_owner_guide_settings_desc">Learn how to enable stronger child-device controls</string>
    <string name="device_owner_guide_intro">Device Owner is an Android managed-device mode. It is not the same as a normal app permission and usually requires setting up the child phone from a reset or fresh setup.</string>
    <string name="device_owner_guide_adb_label">ADB test command (use only after reset, with the child APK installed)</string>
    <string name="device_owner_guide_adb_command">adb shell dpm set-device-owner com.android.system.services.internal/com.parentalguard.child.receiver.AdminReceiver</string>
    <string name="device_owner_guide_step_1">Back up anything important, then factory-reset the child device if it is already configured for personal use.</string>
    <string name="device_owner_guide_step_2">Install Kid Guard on the child device before completing Android setup.</string>
    <string name="device_owner_guide_step_3">Provision Kid Guard as the Device Owner using your supported Android Enterprise provisioning method or managed-device setup command.</string>
    <string name="device_owner_guide_step_4">Open the child app, finish pairing with the parent app, and keep the child service running.</string>
    <string name="device_owner_guide_step_5">Return to this child console and refresh. Each advanced control becomes available only after the child reports its capability.</string>
    <string name="device_owner_guide_note">Device Owner setup is device-specific. Do not use root or unofficial tools, and do not assume that a connected device supports advanced controls.</string>
