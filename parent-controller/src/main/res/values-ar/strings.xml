    <!-- ============ Onboarding ============ -->
    <string name="onboarding_skip">تخطّى</string>
    <string name="onboarding_next">التالي</string>
    <string name="onboarding_get_started">هيا نبداو</string>
    <string name="onboarding_welcome_title">مرحبا بيك ف Kid Guard</string>
    <string name="onboarding_welcome_body">مركز القيادة الهادئ ديال عيلتك. راقب وقت الشاشة، حدد الحدود، وحمي ولادك أونلاين — كامل من تطبيق واحد.</string>
    <string name="onboarding_discover_title">لقا جهاز ولدك</string>
    <string name="onboarding_discover_body">فتح The Circle ودوز على Scan network. الأجهزة اللي فيها Kid Guard فنفس الواي فاي كيظهرو بوحدهم. ماكاينش واي فاي؟ زاوج بـ Bluetooth.</string>
    <string name="onboarding_discover_path">The Circle → Scan network</string>
    <string name="onboarding_install_title">صيفط تطبيق الطفل</string>
    <string name="onboarding_install_body">تيليفون ولدك محتاج نسخته الخاصة من Kid Guard. فتح Control ودوز على Send child app باش تصيفط الـ APK بـ Quick Share أو Bluetooth أو أي تطبيق آخر.</string>
    <string name="onboarding_install_path">Control → Send child app</string>
    <string name="onboarding_pair_title">سكانّي باش تزاوج</string>
    <string name="onboarding_pair_body">فتح Kid Guard فتليفون ولدك وخلي كود QR كيبان. على تليفونك دوز على Pair with QR وسكانّيه — الجهاز كيدخل لدائرة ديالك مباشرة.</string>
    <string name="onboarding_pair_path">Pair with QR</string>
    <string name="onboarding_control_title">حامي وموجه</string>
    <string name="onboarding_control_body">دوز على أي جهاز باش تفتح وحدة التحكم ديالو. قفل الشاشة، بلوكي التطبيقات، حدد الحدود اليومية، خد استراحات، وتابع التقرير ديال اليوم.</string>
    <string name="onboarding_control_path">وحدة التحكم</string>

    <!-- ============ Device Owner guide (full Samsung tutorial) ============ -->
    <string name="device_owner_guide_copy">نسخ</string>
    <string name="device_owner_guide_copied">تنسخ الأمر — لصقو ف PowerShell / terminal</string>
    <string name="device_owner_guide_phase_1_title">حفظ، ومن بعد إعادة الضبط</string>
    <string name="device_owner_guide_phase_1_body">Device Owner خدام غير على جهاز جديد. حفظ التصاور والملفات، ومن بعد الإعدادات ← الإدارة العامة ← إعادة الضبط ← إعادة ضبط المصنع.</string>
    <string name="device_owner_guide_phase_2_title">أول تشغيل: بلا حسابات</string>
    <string name="device_owner_guide_phase_2_body">دخل للواي فاي، ولكن ما تزيد حتى حساب Google ولا Samsung. تخطى تسجيل الدخول — الحسابات كيبلوكيو الأمر.</string>
    <string name="device_owner_guide_phase_3_title">فعل USB debugging</string>
    <string name="device_owner_guide_phase_3_body">الإعدادات ← حول الجهاز ← معلومات البرنامج ← دق على رقم الإصدار 7 مرات. ومن بعد خيارات المطور ← USB debugging ON. وصل الجهاز بالPC وقبل الطلب.</string>
    <string name="device_owner_guide_phase_4_title">ثبت تطبيق الولد</string>
    <string name="device_owner_guide_phase_4_body">من تطبيق الوالد دير “صيفط تطبيق الولد”، ولا من الPC دير: adb install -r kidguard-child.apk. تأكد بـ: adb devices.</string>
    <string name="device_owner_guide_phase_5_title">دير Kid Guard هو Device Owner</string>
    <string name="device_owner_guide_phase_5_body">فالPC دير أمر ADB اللي الفوق (زر النسخ). ملي تنجح غادي يقول “Device owner set”. من بعد تقدر ترجع الحسابات.</string>
    <string name="device_owner_guide_phase_6_title">عطي جميع الأذونات</string>
    <string name="device_owner_guide_phase_6_body">حل تطبيق الولد: سمح بالوصول للاستخدام، العرض فوق التطبيقات، إمكانية الوصول (Kid Guard Blocker)، والبلوتوث. خلي كود QR باين.</string>
    <string name="device_owner_guide_phase_7_title">حماية سامسونغ من الإغلاق</string>
    <string name="device_owner_guide_phase_7_body">التطبيقات ← System Service ← البطارية ← غير مقيدة. البطارية ← حدود الخلفية ← تطبيقات لا تنام ← زيدو. العناية بالجهاز ← التحسين التلقائي OFF.</string>
    <string name="device_owner_guide_phase_8_title">زاوج من تطبيق الوالد</string>
    <string name="device_owner_guide_phase_8_body">تطبيق الوالد ← الدائرة ← Pair with QR ← سكانّي التابلت. نفس الواي فاي لأول مرة؛ البلوتوث والسحابة خدامين من بعد.</string>
    <string name="device_owner_guide_phase_9_title">تأكد، ومن بعد خبي الأيقونة</string>
    <string name="device_owner_guide_phase_9_body">حل كونسول الولد ← متقدم ← “privileges confirmed”. غير من بعد دير إخفاء الأيقونة فتطبيق الولد. من بعد سيرو من عند الوالد.</string>
    <string name="device_owner_guide_trouble_title">إلا فشل الأمر</string>
    <string name="device_owner_guide_trouble_body">“Accounts added” ← مسح جميع حسابات Google/Samsung وعاود. “Already provisioned” ← عاود إعادة الضبط. “No device” ← شوف الكابل و adb devices وقبل طلب USB.</string>

