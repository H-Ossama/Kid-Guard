    <string name="onboarding_welcome_title">Bienvenue sur Kid Guard</string>
    <string name="onboarding_welcome_body">Le centre de commande calme de votre famille. Surveillez le temps d\'écran, fixez des limites et protégez vos enfants en ligne — tout depuis une seule appli.</string>
    <string name="onboarding_discover_title">Trouvez leur appareil</string>
    <string name="onboarding_discover_body">Ouvrez Le Cercle et touchez Scanner le réseau. Tout appareil avec Kid Guard sur le même Wi-Fi apparaît automatiquement. Pas de Wi-Fi ? Jumelez plutôt par Bluetooth.</string>
    <string name="onboarding_discover_path">Le Cercle → Scanner le réseau</string>
    <string name="onboarding_install_title">Envoyez l\'appli enfant</string>
    <string name="onboarding_install_body">Le téléphone de votre enfant a besoin de sa propre copie de Kid Guard. Ouvrez Contrôle et touchez Envoyer l\'appli enfant pour partager l\'APK via Quick Share, Bluetooth ou toute appli de transfert.</string>
    <string name="onboarding_install_path">Contrôle → Envoyer l\'appli enfant</string>
    <string name="onboarding_pair_title">Scannez pour connecter</string>
    <string name="onboarding_pair_body">Ouvrez Kid Guard sur le téléphone de l\'enfant et gardez son QR affiché. Sur votre téléphone, touchez Jumeler avec QR et scannez-le — l\'appareil rejoint votre cercle aussitôt.</string>
    <string name="onboarding_pair_path">Jumeler avec QR</string>
    <string name="onboarding_control_title">Gardez et guidez</string>
    <string name="onboarding_control_body">Touchez un appareil pour ouvrir sa console. Verrouillez l\'écran, bloquez des applis, fixez des limites quotidiennes, faites des pauses et suivez le rapport du jour.</string>
    <string name="onboarding_control_path">Console de l\'appareil</string>

    <!-- ============ Device Owner guide (full Samsung tutorial) ============ -->
    <string name="device_owner_guide_copy">Copier</string>
    <string name="device_owner_guide_copied">Commande copiée — collez-la dans PowerShell / terminal</string>
    <string name="device_owner_guide_phase_1_title">Sauvegardez, puis réinitialisez</string>
    <string name="device_owner_guide_phase_1_body">Device Owner ne marche que sur un appareil neuf. Sauvegardez photos et fichiers, puis Paramètres → Gestion globale → Réinitialisation → Réinitialiser toutes les données.</string>
    <string name="device_owner_guide_phase_2_title">Premier démarrage : sans comptes</string>
    <string name="device_owner_guide_phase_2_body">Connectez le Wi-Fi, mais n\'ajoutez encore aucun compte Google ni Samsung. Ignorez la connexion — les comptes bloquent la commande owner.</string>
    <string name="device_owner_guide_phase_3_title">Activez le débogage USB</string>
    <string name="device_owner_guide_phase_3_body">Paramètres → À propos de la tablette → Infos logiciel → touchez 7 fois Numéro de version. Puis Options développeur → Débogage USB ON. Connectez au PC et acceptez l\'invite.</string>
    <string name="device_owner_guide_phase_4_title">Installez l\'APK enfant</string>
    <string name="device_owner_guide_phase_4_body">Depuis cette appli parent utilisez « Envoyer l\'appli enfant », ou depuis le PC : adb install -r kidguard-child.apk. Vérifiez avec : adb devices.</string>
    <string name="device_owner_guide_phase_5_title">Déclarez Kid Guard Device Owner</string>
    <string name="device_owner_guide_phase_5_body">Sur PC, lancez la commande ADB ci-dessus (bouton copier). En cas de succès : « Device owner set ». Vous pourrez ensuite rajouter les comptes.</string>
    <string name="device_owner_guide_phase_6_title">Accordez chaque autorisation</string>
    <string name="device_owner_guide_phase_6_body">Ouvrez l\'appli enfant : autorisez l\'accès utilisation, l\'affichage par-dessus, l\'accessibilité (Kid Guard Blocker) et le Bluetooth. Gardez son QR affiché.</string>
    <string name="device_owner_guide_phase_7_title">Maintien Samsung (à ne pas sauter)</string>
    <string name="device_owner_guide_phase_7_body">Applis → System Service → Batterie → Non restreinte. Batterie → Limites d\'arrière-plan → Applis jamais en veille → ajoutez-la. Maintenance → Optimisation auto OFF.</string>
    <string name="device_owner_guide_phase_8_title">Jumelez depuis le parent</string>
    <string name="device_owner_guide_phase_8_body">Appli parent → Le Cercle → Jumeler avec QR → scannez la tablette. Même Wi-Fi pour le premier jumelage ; Bluetooth et relais cloud ensuite.</string>
    <string name="device_owner_guide_phase_9_title">Vérifiez, puis masquez l\'icône</string>
    <string name="device_owner_guide_phase_9_body">Ouvrez la console enfant → Avancé → « privilèges confirmés ». Ensuite seulement, utilisez Masquer l\'icône dans l\'appli enfant. Gérez-la depuis le parent après.</string>
    <string name="device_owner_guide_trouble_title">Si la commande échoue</string>
    <string name="device_owner_guide_trouble_body">« Comptes ajoutés » → supprimez tous les comptes Google/Samsung et réessayez. « Déjà provisionné » → réinitialisez à nouveau. « Aucun appareil » → vérifiez le câble, adb devices, acceptez l\'invite USB.</string>

